<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- KaraVox production traffic must use TLS. No legacy Listen Together cleartext server is mounted. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
